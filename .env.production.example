# ==============================================================================
# BENGKELIN - PRODUCTION ENVIRONMENT VARIABLES (RENDER & SUPABASE)
# ==============================================================================

# Core Application Settings
APP_NAME=Bengkelin
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://bengkelin.onrender.com

# Localization & Logging
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Supabase PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxx
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# Drivers & Performance
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Supabase Storage (S3 Compatible API)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=bengkelin-storage
AWS_ENDPOINT=https://xxxxxxxxxxxxxx.supabase.co/storage/v1/s3
AWS_URL=https://xxxxxxxxxxxxxx.supabase.co/storage/v1/object/public/bengkelin-storage
AWS_USE_PATH_STYLE_ENDPOINT=true

# Frontend Configuration
VITE_APP_NAME="${APP_NAME}"
